# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Secrets / config ---
.env
.env.local
# keep the template tracked
!.env.example

# --- Model / library caches (large, re-downloadable) ---
.cache/
~/.EasyOCR/
*.traineddata

# --- Generated results (regenerated by the harness) ---
results/*.jsonl
results/*.csv
results/metrics.md
results/figures/*.png
# keep the results/ folder structure in git
!results/
!results/figures/
!results/.gitkeep
!results/figures/.gitkeep

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Local-only working files ---
PLAN.md

# Original drop folder — reorganized into data/images/ (the tracked corpus)
OCR_Images/

# --- Tracked on purpose (documentation & corpus) ---
# README.md, RATIONALE.md, data/ are NOT ignored.
